# Vercel Deployment Ignore Configuration
# Prevents Vercel Python builder from scanning Streamlit app files as serverless entrypoints

# Streamlit application files (preserved for local run and Streamlit Community Cloud)
app.py
views/
.streamlit/
train.py
tests/
.pytest_cache/

# Local virtual environment and caches
.venv/
venv/
__pycache__/
*.pyc

# Local git and docs
.git/
.github/
